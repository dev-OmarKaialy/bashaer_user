rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Question media is fetched by the student app over public HTTPS URLs.
    // Writes are done by the seed tool with a service account (IAM), not the app.
    match /question-media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}